# ===== HTTP 代理（可选）=====
# 当 VPS / 本机被某些交易所封锁时，可以让所有交易所 REST 请求走本地代理转发。
# 典型场景：本机运行 clash/v2ray，混合端口监听 127.0.0.1:7890。
# 留空则直连。HTTP 与 SOCKS5 都被 httpx 支持。
# HTTP_PROXY_URL=http://127.0.0.1:7890
# HTTP_PROXY_URL=socks5://127.0.0.1:7890

# ===== Binance API（合约）=====
# 仅在需要私有数据时配置；公开 K 线/Trades 不需要
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 公开 REST 基址（默认主网；fapi.binance.com 在某些 IP 被封禁时改成测试网）
# 主网:   https://fapi.binance.com
# 测试网: https://testnet.binancefuture.com
BINANCE_REST_BASE_URL=https://fapi.binance.com

# ===== Coinglass API =====
# 用于获取 OI 加权资金费率
COINGLASS_API_KEY=

# ===== Telegram 通知 =====
# Phase 3 已实装。从 @BotFather 创建 bot，从 @userinfobot 取 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 企业微信群机器人 =====
# Phase 3 已实装。群设置 → 机器人 → 添加机器人 → webhook URL
# WECHAT_WORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR-KEY

# ===== 飞书 / Lark 群自定义机器人 =====
# Phase 3 已实装。群设置 → 群机器人 → 添加机器人 → 自定义机器人 → webhook URL
# LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR-KEY
# LARK_SIGNING_SECRET=  # 可选，机器人启用签名校验时填写
# 可选：分周期机器人覆盖（若配置，1H/4H/1D 会被路由推送到不同群机器人；否则默认使用上方全局 Webhook）
# LARK_WEBHOOK_URL_1H=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR-1H-KEY
# LARK_WEBHOOK_URL_4H=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR-4H-KEY
# LARK_WEBHOOK_URL_1D=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR-1D-KEY

# ===== 应用配置 =====
APP_ENV=development            # development | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
DUCKDB_PATH=./data/pa.duckdb

# ===== 数据采集配置 =====
SYMBOL=BTCUSDT
TIMEFRAMES=1m,5m,15m,1h,4h,1d
COINGLASS_POLL_INTERVAL_SEC=10
OI_POLL_INTERVAL_SEC=60

# ===== Web Server =====
API_HOST=127.0.0.1
API_PORT=8000

# ===== LLM API（大模型分析）=====
# 核心功能所需。支持 OpenAI、DeepSeek 或任何 OpenAI 兼容 API。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=2000
# 可选：分周期大模型最大生成 Token 限制（若配置，对应周期的分析会使用专属限制以优化成本或允许长文本；未配置则默认使用上方 LLM_MAX_TOKENS）
# LLM_MAX_TOKENS_1H=1000
# LLM_MAX_TOKENS_4H=1500
# LLM_MAX_TOKENS_1D=3000
# 大模型调用超时时间（秒，针对推理型/思考型慢模型建议设为 180）
LLM_TIMEOUT=180

# ===== CoinGecko API（备用高可用数据源）=====
# 当币安 API 遭遇 418 WAF 限频或 302 区域封锁时，作为高可用降级源获取合约资金费率及持仓量
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

